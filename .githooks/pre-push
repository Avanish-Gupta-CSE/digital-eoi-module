#!/bin/sh
# Reject any push that updates main or master.
# Branch protection needs GitHub Pro on private repos, so this is the local equivalent.
# Install once per clone:  git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo ""
      echo "BLOCKED: pushing directly to $remote_ref is not allowed."
      echo "Create a branch, push it, and open a pull request. See CONTRIBUTING.md."
      echo ""
      exit 1
      ;;
  esac
done
exit 0
