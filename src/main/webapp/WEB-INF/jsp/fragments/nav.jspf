<header class="app-header">
    <div class="app-header-inner">
        <a class="brand text-decoration-none" href="${pageContext.request.contextPath}/dashboard">
            <img class="brand-logo" src="${pageContext.request.contextPath}/assets/images/uco_bank_logo.png"
                 alt="UCO Bank">
            <span class="brand-text">
                <span class="brand-bank">Digital EoI Module</span>
                <span class="brand-module">Credit Information Exchange &middot; RBI Paras 127&ndash;128</span>
            </span>
        </a>
        <c:if test="${not hideStaff}">
        <div class="header-right">
            <span class="env-chip">DEV</span>
            <c:choose>
                <c:when test="${not empty sessionScope.staff}">
                    <span class="user-pill"><strong><c:out value="${sessionScope.staff.name}"/></strong></span>
                    <span class="user-pill">EMP ID <strong><c:out value="${sessionScope.staff.empNo}"/></strong></span>
                    <span class="user-pill">SOL ID <strong><c:out value="${sessionScope.staff.solId}"/></strong></span>
                    <span class="user-pill user-pill-role"><c:out value="${sessionScope.staff.role}"/></span>
                    <form method="post" action="${pageContext.request.contextPath}/logout" class="m-0">
                        <input type="hidden" name="_csrf" value="<c:out value='${sessionScope._csrf}'/>">
                        <button type="submit" class="signout-button">Sign out</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <span class="user-pill"><strong>Credit Officer</strong></span>
                    <span class="user-pill user-pill-role">Maker</span>
                </c:otherwise>
            </c:choose>
        </div>
        </c:if>
    </div>
</header>
<c:if test="${not hideStaff}">
<nav class="app-nav" aria-label="Main">
    <div class="app-nav-inner">
        <a class="app-nav-link active" href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
    </div>
</nav>
</c:if>
