<header class="app-header">
    <div class="app-header-inner">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>
                </svg>
            </span>
            <span class="brand-text">
                <span class="brand-bank">UCO Bank</span>
                <span class="brand-module">Digital EoI &middot; Credit Information Exchange</span>
            </span>
        </div>
        <div class="header-right">
            <span class="env-chip">DEV</span>
            <c:choose>
                <c:when test="${not empty sessionScope.staff}">
                    <div class="user-block">
                        <span class="user-avatar" aria-hidden="true">${sessionScope.staff.initials()}</span>
                        <span class="user-meta">
                            <span class="user-name">${sessionScope.staff.name}</span>
                            <span class="user-role">${sessionScope.staff.role}</span>
                        </span>
                    </div>
                    <form method="post" action="${pageContext.request.contextPath}/logout">
                        <button type="submit" class="signout-button">Sign out</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <div class="user-block">
                        <span class="user-avatar" aria-hidden="true">CO</span>
                        <span class="user-meta">
                            <span class="user-name">Credit Officer</span>
                            <span class="user-role">Maker</span>
                        </span>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
